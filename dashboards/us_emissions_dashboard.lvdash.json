{
  "datasets": [
    {
      "name": "f52ede3a",
      "displayName": "Emission location data",
      "queryLines": [
        "SELECT latitude,longitude,`GHG emissions mtons CO2e` as emissions\r\n",
        "FROM emissions.default.emissions_data_us"
      ]
    },
    {
      "name": "206a1d29",
      "displayName": "emissions per person",
      "queryLines": [
        "SELECT\r\n",
        "  CONCAT(county_name, ', ', state_abbr) AS county_state_name,\r\n",
        "  population,\r\n",
        "  ROUND(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / population, 2) AS emissions_per_person\r\n",
        "FROM emissions.default.emissions_data_us\r\n",
        "ORDER BY emissions_per_person DESC\r\n"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "742f6f17",
      "displayName": "Emissions by states",
      "queryLines": [
        "SELECT\r\n",
        "  state_abbr,\r\n",
        "  SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) AS total_emissions\r\n",
        "FROM emissions.default.emissions_data_us\r\n",
        "group BY state_abbr\r\n",
        "ORDER BY total_emissions DESC\r\n",
        "LIMIT 10\r\n"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "664146af",
      "displayName": "top county emissions",
      "queryLines": [
        "SELECT\r\n",
        "  county_state_name,\r\n",
        "  population,\r\n",
        "  CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) AS total_emissions\r\n",
        "FROM emissions.default.emissions_data_us\r\n",
        "ORDER BY total_emissions DESC\r\n",
        "LIMIT 10"
      ]
    }
  ],
